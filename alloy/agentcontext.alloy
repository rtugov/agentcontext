loki.source.file "agentcontext_audit" {
  targets = [
    {
      __path__      = sys.env("AC_REQUEST_LOG"),
      service_name = "agentcontext",
      component    = "ac_proxy",
    },
  ]

  forward_to              = [loki.process.agentcontext_audit.receiver]
  tail_from_end            = false
  on_positions_file_error = "restart_from_beginning"
}

loki.process "agentcontext_audit" {
  stage.json {
    expressions = {
      timestamp = "",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"
  }

  forward_to = [loki.write.agentcontext.receiver]
}

loki.write "agentcontext" {
  endpoint {
    url = sys.env("LOKI_URL")
  }
}
